# =============================================================================
# Insights Collective — environment template
# Copy to .env (scripts/setup-env.sh does this for you) and fill in values.
# .env and .env.local are gitignored; NEVER commit real secrets.
# =============================================================================

# --- App / Supabase --------------------------------------------------------
# The app falls back to the hosted project defaults in src/config/security.ts
# when these are unset, so local dev works out of the box. Set them to point
# at a different Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- E2E: server -----------------------------------------------------------
# Where Playwright finds the app. Defaults to the Vite dev/preview port.
E2E_BASE_URL=http://localhost:8080

# Sandboxed/cloud environments: point Playwright at a pre-installed Chromium
# instead of downloading browsers (leave empty on a normal dev machine).
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# --- E2E: auth -------------------------------------------------------------
# Used by e2e/global-setup.ts to sign in via the Supabase password grant and
# save storage state per role. Missing passwords do NOT fail setup — those
# specs silently run logged-out. E2E_TEST_PASSWORD is a shared fallback.
# Note: global-setup reads VITE_SUPABASE_PUBLISHABLE_KEY as an alternative
# name for the anon key; set it to the same value as VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=
E2E_TEST_PASSWORD=
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=
E2E_INSTRUCTOR_EMAIL=instructor@example.com
E2E_INSTRUCTOR_PASSWORD=
E2E_MEMBER_EMAIL=member@example.com
E2E_MEMBER_PASSWORD=

# --- E2E: seed data --------------------------------------------------------
# Set to 1 to skip the seed-data verification when no seeded DB is available.
E2E_SKIP_SEED_CHECK=1

# IDs of seeded records used by the course/assessment specs
# (see e2e/fixtures/seed.sql and e2e/fixtures/seed-check.ts).
# Fixture row ids. Where these are unset, e2e/helpers/route-helpers.ts falls
# back to placeholders — and several of those are not UUIDs, so the app
# issues a query Postgres rejects with 22P02 and the console-error fixture
# fails the spec against the placeholder rather than the page. Point them at
# real rows (seeded ids where they exist) before trusting a run.
E2E_TEST_COURSE_ID=
E2E_TEST_MODULE_ID=
E2E_TEST_LESSON_ID=
E2E_TEST_ASSIGNMENT_ID=
E2E_TEST_QUIZ_ID=
E2E_TEST_SUBMISSION_ID=
E2E_TEST_FORUM_ID=
E2E_TEST_THREAD_ID=
E2E_TEST_EVENT_ID=
E2E_TEST_BLOG_SLUG=
E2E_TEST_SURVEY_SLUG=
E2E_TEST_SURVEY_FORM_ID=
E2E_TEST_FORM_SLUG=
E2E_TEST_PORTFOLIO_ID=
E2E_TEST_PORTFOLIO_URL=
E2E_TEST_ASSISTANT_ID=
E2E_TEST_RUBRIC_ID=
E2E_TEST_ADMIN_COURSE_ID=
