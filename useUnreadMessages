import { useState, useEffect } from 'react';
import { supabase } from '@/integrations/supabase/client';
import { useAuth } from '@/contexts/AuthContext';

/**
 * Hook to track unread messages across conversations
 */
export function useUnreadMessages() {
  const [unreadCounts, setUnreadCounts] = useState({
    total: 0,
    byConversation: {}
  });
  const [loading, setLoading] = useState(true);
  const { user } = useAuth();

  useEffect(() => {
    if (!user) {
      setUnreadCounts({ total: 0, byConversation: {} });
      setLoading(false);
      return;
    }

    const fetchUnreadCounts = async () => {
      setLoading(true);
      try {
        // Get conversations where the user is a participant
        const { data: participantData, error: participantError } = await supabase
          .from('conversation_participants')
          .select('conversation_id')
          .eq('user_id', user.id);

        if (participantError) throw participantError;
        if (!participantData?.length) {
          setUnreadCounts({ total: 0, byConversation: {} });
          setLoading(false);
          return;
        }

        const conversationIds = participantData.map(p => p.conversation_id);

        // Get unread message counts by conversation
        const { data: countsData, error: countsError } = await supabase
          .from('messages')
          .select('conversation_id, count', { count: 'exact' })
          .eq('read', false)
          .neq('sender_id', user.id)
          .in('conversation_id', conversationIds)
          .group('conversation_id');

        if (countsError) throw countsError;

        // Transform to a more usable format
        const countsByConversation = {};
        let totalCount = 0;

        if (countsData) {
          countsData.forEach(item => {
            countsByConversation[item.conversation_id] = parseInt(item.count);
            totalCount += parseInt(item.count);
          });
        }

        setUnreadCounts({
          total: totalCount,
          byConversation: countsByConversation
        });
      } catch (error) {
        console.error('Error fetching unread message counts:', error);
      } finally {
        setLoading(false);
      }
    };

    fetchUnreadCounts();

    // Set up real-time listener for new messages
    const channel = supabase
      .channel('unread-messages')
      .on('postgres_changes',
        {
          event: 'INSERT',
          schema: 'public',
          table: 'messages',
          filter: `read=eq.false`
        },
        payload => {
          // Only count messages not sent by the current user
          if (payload.new.sender_id !== user.id) {
            const conversationId = payload.new.conversation_id;
            
            setUnreadCounts(prev => {
              const newByConversation = { ...prev.byConversation };
              newByConversation[conversationId] = (newByConversation[conversationId] || 0) + 1;
              
              return {
                total: prev.total + 1,
                byConversation: newByConversation
              };
            });
          }
        }
      )
      .on('postgres_changes',
        {
          event: 'UPDATE',
          schema: 'public',
          table: 'messages',
          filter: `read=eq.true`
        },
        payload => {
          // Message was marked as read, refresh counts
          fetchUnreadCounts();
        }
      )
      .subscribe();

    return () => {
      supabase.removeChannel(channel);
    };
  }, [user]);

  return { unreadCounts, loading };
}
